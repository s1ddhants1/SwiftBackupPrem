    <string name="wizard_step1_desc">Create a new Firebase project in the Firebase Console (e.g. SwiftBackup-Personal). Google Analytics can be disabled.</string>
    <string name="wizard_step2_desc">Create a Realtime Database in locked mode, paste the user-isolated security rules in the Rules tab, and copy your Database URL.</string>
    <string name="wizard_step3_desc">Navigate to Security > Authentication > Sign-in method, enable Google, and save your project support email.</string>
    <string name="wizard_step3_storage_note">Cloud Storage is optional and can be skipped on the free Spark plan. Swift Backup only uses Firebase for authentication and metadata.</string>
    <string name="wizard_step4_app_title">1. Register Android App</string>
    <string name="wizard_step4_app_desc">Add an Android app with package name org.swiftapps.swiftbackup and SHA-1 fingerprint. Download google-services.json.</string>
    <string name="wizard_step4_oauth_title">2. Configure OAuth Client</string>
    <string name="wizard_step4_oauth_desc">In Google Cloud Console APIs &amp; Services > Credentials, edit the Android client, enable Custom URI scheme under Advanced settings, and copy your Client ID.</string>
    <string name="wizard_step5_drive_api_title">1. Enable Drive API</string>
    <string name="wizard_step5_drive_api_desc">Enable Google Drive API in Google Cloud Console to allow Swift Backup to create and access cloud backups.</string>
    <string name="wizard_step5_scopes_title">2. Add Drive OAuth Scope</string>
    <string name="wizard_step5_scopes_desc">Under Data Access > Add or remove scopes, add the drive.file scope.</string>
